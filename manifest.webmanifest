{
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "name": "notepad--",
  "short_name": "notepad--",
  "description": "Local-only notepad and code editor. Notes stay in your browser.",
  "display": "standalone",
  "background_color": "#0c1017",
  "theme_color": "#131823",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "icons": [
        {
          "src": "icons/file-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "icons/file-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "accept": {
        "text/plain": [
          ".txt",
          ".log",
          ".ini",
          ".conf",
          ".cfg"
        ],
        "text/markdown": [
          ".md"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ],
        "application/x-yaml": [
          ".yaml",
          ".yml"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/*",
            "application/json",
            "application/x-yaml",
            ".txt",
            ".log",
            ".md",
            ".csv",
            ".json",
            ".yaml",
            ".yml",
            ".ini",
            ".conf",
            ".cfg"
          ]
        }
      ]
    }
  }
}